    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5-mini\",\n  \"input\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es DEMANDOO AI. Réponds en wolof sénégalais simple, naturel et court, adapté à une réponse vocale. Tu peux mélanger légèrement le français pour les heures, prix et lieux. N'invente aucun trajet, prix ou place. Si la liste est vide, dis simplement qu'aucun trajet correspondant n'est disponible et invite à essayer une autre heure/date.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ ('Résultats Demandoo: ' + JSON.stringify($('Chercher trajets Supabase').all().map(i => i.json).filter(o => o && Object.keys(o).length))).toJsonString() }}\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Réponse Wolof",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        -120
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nlet text = '';\nif (typeof r.output_text === 'string') text = r.output_text;\nif (!text && Array.isArray(r.output)) {\n  for (const item of r.output || []) for (const c of item.content || []) if (typeof c.text === 'string') text += c.text;\n}\nconsole.log('[DEMANDOO VOICE] STEP 5 RESPONSE GENERATED');\nreturn [{ json: { text: text.trim() } }];"
      },
      "name": "Extraire réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
