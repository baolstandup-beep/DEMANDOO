    {
      "parameters": {
        "jsCode": "const missing = Array.isArray($json.missing) ? $json.missing : [];\nconst map = {\n  departure: 'Fan nga bëgg jóge?',\n  destination: 'Fan nga bëgg dem?',\n  date: 'Ban bés nga bëgg dem?',\n  time: 'Ban waxtu nga bëgg dem?',\n  passengers: 'Ñaata nit ngeen?'\n};\nconst first = missing[0] || 'destination';\nreturn [{ json: { text: map[first] || 'Lan lañu war a xam ngir seet trajet bi?' } }];"
      },
