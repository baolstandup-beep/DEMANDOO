    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5-mini\",\n  \"input\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es DEMANDOO AI. La date d'aujourd'hui est {{ $now.toFormat('yyyy-MM-dd') }}. Comprends le wolof sénégalais, le français et leur mélange. Extrais strictement les informations d'une recherche de covoiturage. Réponds uniquement en JSON valide avec: departure, destination, date, time, passengers, missing. date doit être YYYY-MM-DD si déterminable. passengers doit être un entier. missing est un tableau des champs manquants. N'invente rien.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.text) }}\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Comprendre demande",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrait le texte produit par l'API Responses puis le parse en JSON.\nconst r = $json;\nlet raw = '';\nif (typeof r.output_text === 'string') raw = r.output_text;\nif (!raw && Array.isArray(r.output)) {\n  for (const item of r.output) {\n    if (!Array.isArray(item.content)) continue;\n    for (const c of item.content) {\n      if (typeof c.text === 'string') raw += c.text;\n    }\n  }\n}\nconst fence = String.fromCharCode(96).repeat(3);\nraw = raw.trim()\n  .replace(new RegExp('^' + fence + 'json\\s*', 'i'), '')\n  .replace(new RegExp(fence + '\\s*$'), '')\n  .trim();\nlet parsed;\ntry { parsed = JSON.parse(raw); }\ncatch (e) {\n  return [{ json: { ok: false, error: 'AI_JSON_PARSE_FAILED', raw } }];\n}\nreturn [{ json: { ...parsed, ok: true, missing: Array.isArray(parsed.missing) ? parsed.missing : ['destination'] } }];"
      },
      "name": "Parser recherche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dd91c7cf-e062-4497-bd8e-6ce3df619767",
              "leftValue": "={{ $json.ok === true && Array.isArray($json.missing) && $json.missing.length === 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Infos complètes ?",
