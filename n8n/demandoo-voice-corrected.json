      "id": "f06087c8-81ef-430d-8557-06c6d0b69a50",
      "name": "Valider audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        -220
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst audio = item.binary?.audio;\nconsole.log('[DEMANDOO VOICE] STEP 1 WEBHOOK RECEIVED');\nif (!audio) return [{ json: { success: false, error: 'AUDIO_MISSING', message: 'Aucun fichier audio reçu.', status: 400 } }];\nconst mime = audio.mimeType || '';\nconst size = Number(audio.fileSize || 0);\nconst allowed = ['audio/ogg','audio/opus','audio/mpeg','audio/mp3','audio/mp4','audio/m4a','audio/x-m4a','audio/wav','audio/x-wav','audio/webm'];\nif (!allowed.some(type => mime.toLowerCase().startsWith(type))) {\n  return [{ json: { success: false, error: 'AUDIO_FORMAT_INVALID', message: 'Format audio non pris en charge.', status: 415 } }];\n}\nconsole.log('[DEMANDOO VOICE] STEP 2 AUDIO FOUND', { mimeType: mime, size });\nconsole.log('[DEMANDOO VOICE] STEP 3 TRANSCRIPTION START', { mimeType: mime, size });\nreturn [{ json: { success: true, mimeType: mime, size }, binary: item.binary }];"
      }
    },
    {
      "id": "2d291975-69b3-49a1-a43c-9a66e3494683",
      "name": "Audio valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -620,
