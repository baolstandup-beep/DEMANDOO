              "keyName": "arrival_city",
              "condition": "eq",
              "keyValue": "={{ $json.destination }}"
            },
            {
              "keyName": "departure_datetime",
              "condition": "gte",
              "keyValue": "={{ $json.date + \"T00:00:00Z\" }}"
            },
            {
              "keyName": "departure_datetime",
              "condition": "lt",
              "keyValue": "={{ new Date(Date.parse($json.date + \"T00:00:00Z\") + 86400000).toISOString() }}"
            },
            {
              "keyName": "seats_available",
              "condition": "gte",
              "keyValue": "={{ $json.passengers }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "scheduled"
            }
          ]
        }
      },
