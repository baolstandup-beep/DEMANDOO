      "parameters": {
        "jsCode": "const r = $json;\nlet text = '';\nif (typeof r.output_text === 'string') text = r.output_text;\nif (!text && Array.isArray(r.output)) {\n  for (const item of r.output || []) for (const c of item.content || []) if (typeof c.text === 'string') text += c.text;\n}\nreturn [{ json: { text: text.trim() } }];"
      },
