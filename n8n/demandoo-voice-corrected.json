    {
      "id": "454d6c22-85f6-4797-a57a-81354deaf145",
      "name": "Normaliser transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        -220
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst audio = $('Valider audio').first().json;\nif (r.error || typeof r.text !== 'string' || !r.text.trim()) {\n  const reason = String(r.error?.message || '');\n  const missingCredential = /credential|nodeNotCovered/i.test(reason);\n  const errorCode = missingCredential ? 'OPENAI_CREDENTIAL_MISSING' : 'TRANSCRIPTION_FAILED';\n  const status = missingCredential ? 503 : 502;\n  console.error('[DEMANDOO VOICE] TRANSCRIPTION FAILED', { status, errorCode, mimeType: audio.mimeType, size: audio.size });\n  return [{ json: { success: false, error: errorCode, message: 'Impossible de transcrire le message vocal.', status } }];\n}\nconsole.log('[DEMANDOO VOICE] STEP 4 TRANSCRIPTION SUCCESS', { mimeType: audio.mimeType, size: audio.size });\nreturn [{ json: { success: true, language: 'wo', transcription: r.text, source: 'voice', text: r.text } }];"
      }
