## Variables d'environnement Demandoo

# ─── Supabase (Frontend) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Supabase (Backend Vercel Functions — SECRETS, ne jamais préfixer VITE_) ─
# Disponibles dans Supabase > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── Paiements ────────────────────────────────────────────────────────────────
VITE_WAVE_API_KEY=your_wave_api_key
VITE_BICTORYS_API_KEY=your_bictorys_api_key

# ─── SMS / Notifications ──────────────────────────────────────────────────────
VITE_NIMBASMS_SERVICE_ID=your_nimbasms_service_id
VITE_NIMBASMS_SECRET_TOKEN=your_nimbasms_secret_token

# ─── IA / KYC ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
