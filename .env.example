## Variables d'environnement Demandoo
## Règle d'or : tout ce qui commence par VITE_ est PUBLIÉ dans le JavaScript du site.
## Jamais de clé secrète avec le préfixe VITE_.

# ─── Supabase (Frontend — public) ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
# Optionnel : URL des fonctions /api pour l'app native Capacitor
VITE_API_BASE_URL=https://demandoo-kappa.vercel.app

# ─── Supabase (Fonctions Vercel — SECRETS) ────────────────────────────────────
# Supabase > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Sécurité des API ─────────────────────────────────────────────────────────
# Origines autorisées à appeler /api (séparées par des virgules)
ALLOWED_ORIGINS=https://demandoo-kappa.vercel.app
PUBLIC_SITE_URL=https://demandoo-kappa.vercel.app

# ─── Paiements (Fonctions Vercel — SECRETS) ───────────────────────────────────
WAVE_API_KEY=
BICTORYS_API_KEY=
# Edge Function Supabase « payment_webhook » (supabase secrets set …)
#   WAVE_WEBHOOK_SECRET=     secret de signature fourni par Wave
#   PAYMENT_WEBHOOK_SECRET=  secret partagé envoyé par Bictorys (en-tête X-Secret-Key)

# ─── Recherche vocale (Fonction Vercel /api/voice) ────────────────────────────
N8N_VOICE_WEBHOOK_URL=
# Secret envoyé à n8n dans l'en-tête X-Demandoo-Key (à vérifier dans le workflow)
DEMANDOO_VOICE_KEY=

# ─── IA / KYC ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
